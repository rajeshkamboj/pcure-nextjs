# WordPress REST API base URL
# Example: http://pcure.test/wp-json/wp/v2  or  https://pcure.example.com/wp-json/wp/v2
NEXT_PUBLIC_WORDPRESS_API_URL=http://pcure.test/wp-json/wp/v2

# Optional: future server-only variables can be added here without NEXT_PUBLIC_ prefix
# WORDPRESS_API_USERNAME=
# WORDPRESS_API_PASSWORD=

# Secret for POST /api/revalidate (call it from a WordPress publish hook for instant updates)
REVALIDATION_SECRET=change-me-to-a-long-random-string
